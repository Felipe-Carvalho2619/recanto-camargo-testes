# Variáveis de ambiente do backend — use apenas valores locais neste arquivo.

NODE_ENV=development
PORT=3000

# MySQL local
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=recanto_camargo_teste
DB_SSL=false

# Segredos: preencha somente no ambiente local/seguro; nunca use valores reais aqui.
JWT_SECRET=
# RF02: 32 bytes em base64url (43 caracteres), distinto de JWT_SECRET e estável entre reinícios.
RF02_RESET_SECRET=
# Exatamente 64 caracteres hexadecimais (32 bytes).
CPF_ENCRYPTION_KEY=
CPF_HMAC_SECRET=

# URLs e cookies
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:3000
# Origens permitidas, separadas por vírgula.
CORS_ORIGINS=http://localhost:5173
COOKIE_SAMESITE=lax

# E-mail transacional (opcional em desenvolvimento)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Mercado Pago
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_PUBLIC_KEY=
MERCADO_PAGO_WEBHOOK_SECRET=

# Logo usado nas comunicações (opcional)
LOGO_URL=

# Libera a simulação local de pagamento; nunca ativar em produção.
PAGAMENTO_SIMULADO=false
